# URL вашего Cloudflare Worker (используется на фронтенде / в index.html)
WORKER_ENDPOINT=https://billowing-king-7514.fialkamy001.workers.dev

# Секретные ключи API (для отправки в Cloudflare Worker Secrets)
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_API_KEY=your_gemma_api_key_here
NEW_API_KEY=your_backup_api_key_here

# Авторизация в Cloudflare (если деплоите через Wrangler CLI)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here
